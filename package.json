{
  "name": "dsh-session-del",
  "version": "1.0.1",
  "private": true,
  "description": "DSH 会话清理：真删会话（移到 session-trash 可恢复）、清理索引幽灵 id、看回收区与恢复。补上界面缺失的「删除对话」。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./lib/*": "./lib/*",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
